// globeTake (Agora Mundi) Prisma Schema
// Production database: PostgreSQL (Supabase / Neon) with connection pooling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  email            String    @unique
  passwordHash     String?
  googleId         String?   @unique
  avatarColor      String    @default("#1D3557")
  displayName      String
  title            String    @default("Global Affairs Commentator")
  bio              String    @default("")
  countryCode      String    @default("US")
  totalLikes       Int       @default(0)
  weeklyLikes      Int       @default(0)
  followerCount    Int       @default(0)
  followingCount   Int       @default(0)
  globalReachCount Int       @default(0)
  createdAt        DateTime  @default(now())

  sessions         Session[]
  comments         Comment[]
  votes            Vote[]
  followers        Follow[]  @relation("following")
  following        Follow[]  @relation("follower")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Country {
  code                String       @id
  name                String
  officialName        String?
  capital             String?
  region              String
  subregion           String?
  flagEmoji           String
  population          Float?
  areaKm2             Float?
  currencyCode        String?
  currencyName        String?
  currencySymbol      String?
  languagesJson       String?      // JSON string array of languages
  callingCode         String?
  summary             String?      // English Wikipedia country overview
  wikiUrl             String?
  thumbnailUrl        String?
  usdRate             Float?       // 1 USD = X local currency
  tempo               String       // "HOT" | "MODERATE" | "STABLE"
  updateIntervalHours Int
  mapX                Float        // Longitude
  mapY                Float        // Latitude
  lastSyncedAt        DateTime?    // Null until live agendas are fetched
  infoSyncedAt        DateTime?    // Null until live country profile is fetched
  lastUpdatedAt       DateTime     @default(now())

  agendas             AgendaItem[]
}

model AgendaItem {
  id           String    @id @default(cuid())
  countryCode  String
  slot         String    // "A" | "B" | "C"
  title        String
  summary      String    @default("")
  category     String    @default("WORLD")
  sourcesJson  String    @default("[]") // JSON array of { title, publisher, url, publishedAt }
  sourceOrigin String    @default("LIVE_RSS_CURATED") // "GEMINI_GROUNDED" | "LIVE_RSS_CURATED"
  isActive     Boolean   @default(true)
  commentCount Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  country      Country             @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  comments     Comment[]
  translations AgendaTranslation[]

  @@index([countryCode, isActive])
}

model AgendaTranslation {
  id           String     @id @default(cuid())
  agendaItemId String
  languageCode String
  title        String
  summary      String     @default("")
  createdAt    DateTime   @default(now())

  agendaItem   AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)

  @@unique([agendaItemId, languageCode])
  @@index([languageCode])
}

model Comment {
  id             String     @id @default(cuid())
  agendaItemId   String
  authorId       String
  parentId       String?
  content        String
  sourceUrl      String?
  stanceTag      String     @default("COMMENT") // "COMMENT" | "THESIS" | "ANALYSIS" | "SOLUTION" | "CRITIQUE"
  languageCode   String     @default("en")
  likeCount      Int        @default(0)
  replyCount     Int        @default(0)
  aiQualityScore Int        @default(80)
  createdAt      DateTime   @default(now())

  agendaItem     AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  author         User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent         Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]  @relation("CommentReplies")
  votes          Vote[]

  @@index([agendaItemId, parentId])
}

model Vote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model ModerationLog {
  id                String   @id @default(cuid())
  username          String
  countryCode       String
  rejectedContent   String
  violationCategory String
  reason            String
  createdAt         DateTime @default(now())
}
