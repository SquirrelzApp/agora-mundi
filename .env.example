# ==============================================================================
# globeTake (Agora Mundi) — Environment Variables Template (.env.example)
# ==============================================================================

# 1. Database Connection (Supabase / Neon PostgreSQL)
# Runtime Transaction Pooler (Port 6543):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Prisma schema/migration Session Pooler (Port 5432):
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# 2. Session Signing Secret (Use a long random string in production)
AUTH_SECRET="globetake-change-this-secret-in-production-2026"

# 3. Google Gemini API Key (Recommended)
# Get one at: https://aistudio.google.com/apikey
# Curates multi-source live English news into 3 crisp agendas + summaries and powers AI comment moderation.
# Note: Even without this key, the platform runs 100% on live Google News RSS + Bing News RSS.
GEMINI_API_KEY=""
GEMINI_NEWS_MODEL="gemini-3.5-flash-lite"

# 4. Optional: One-Click Google Sign-In (Google OAuth 2.0)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. Optional: Extra News Source (GNews API — Free tier 100 req/day)
# Sign up at: https://gnews.io/
GNEWS_API_KEY=""
