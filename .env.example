# ==============================================================================
# AGORA MUNDI — Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================

# 1. Veritabanı Bağlantısı (Supabase / Neon PostgreSQL)
# Uygulama çalışma zamanı için Transaction Pooler (Port 6543):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Prisma şema/migrasyon işlemleri için Session Pooler (Port 5432):
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# 2. Oturum Güvenlik Anahtarı (Üretim ortamında rastgele uzun bir metin kullanın)
AUTH_SECRET="agora-mundi-change-this-secret-in-production-2026"

# 3. Google Gemini AI Anahtarı (ÜCRETSİZ — Önerilir)
# Nereden alınır: https://aistudio.google.com/apikey
# Ne işe yarar: Çoklu gerçek haber kaynaklarını tek cümlelik keskin Türkçe gündemlere
# ve 2 cümlelik tarafsız özetlere dönüştürür + gelişmiş AI yorum moderasyonu sağlar.
# Not: Bu anahtar girilmese bile site Google News RSS + Bing News RSS + Çeviri ile %100 gerçek verilerle çalışır!
GEMINI_API_KEY=""

# 4. İsteğe Bağlı: Google ile Tek Tık Giriş (Google OAuth 2.0)
# Nereden alınır: https://console.cloud.google.com/apis/credentials
# Yetkili yönlendirme URI (Redirect URI): http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. İsteğe Bağlı: Ek Haber Kaynağı (GNews API — Ücretsiz günde 100 istek katmanı)
# Nereden alınır: https://gnews.io/
GNEWS_API_KEY=""
